# --- App ---
APP_ENV=local
DATABASE_URL=sqlite:///./hr_dashboard.db
SECRET_KEY=change-me-dev-only-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEV ONLY: skips login entirely, auto-authenticating every request as
# DEV_DEFAULT_USER_EMAIL (override per-request with an X-Dev-User-Email
# header). MUST be false before any real deployment.
DISABLE_AUTH=true
DEV_DEFAULT_USER_EMAIL=admin

# --- Microsoft Entra ID (SSO) ---
# Dormant - AUTH_MODE stays "local" until a real App Registration exists.
# Don't flip this to "entra"/"hybrid" until ENTRA_* below are real values;
# the frontend's "Sign in with Microsoft" button only enables itself once
# GET /api/auth/config reports something other than "local".
AUTH_MODE=local
ENTRA_TENANT_ID=placeholder-tenant-id
ENTRA_CLIENT_ID=placeholder-client-id
ENTRA_CLIENT_SECRET=placeholder-client-secret
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/entra/callback

# --- Source system credentials (PLACEHOLDERS) ---
# src/api/jobvite.py and src/api/dayforce.py make REAL http calls using
# these values - they just fail cleanly (JobviteError/DayforceError, logged
# to ingestion_runs) until real values replace the placeholders below.
JOBVITE_URL=https://api.jobvite.com/api/v2
JOBVITE_API_KEY=placeholder-jobvite-api-key
JOBVITE_API_SECRET=placeholder-jobvite-api-secret

DAYFORCE_URL=https://usXX.dayforcehcm.com/api/{clientNamespace}/V1
DAYFORCE_TOKEN_URL=https://dfid.dayforcehcm.com/connect/token
DAYFORCE_CLIENT_NAMESPACE=placeholder-namespace
DAYFORCE_USERNAME=placeholder-dayforce-username
DAYFORCE_PASSWORD=placeholder-dayforce-password
DAYFORCE_CLIENT_ID=Dayforce.HCMAnywhere.Client
