# Read by docker-compose.yaml at the repo root (copy to ".env" here, not
# inside backend/ or frontend/ - those have their own .env.example for
# non-Docker local dev).

# --- Backend ---
SECRET_KEY=change-me-in-production
# Compose defaults to real login (DISABLE_AUTH=false) since it's the
# closer-to-real-deployment path. Set true here for a login-free compose
# stack too.
DISABLE_AUTH=false

# --- Source system credentials (placeholders - see backend/.env.example) ---
JOBVITE_URL=
JOBVITE_API_KEY=
JOBVITE_API_SECRET=
DAYFORCE_URL=
DAYFORCE_TOKEN_URL=https://dfid.dayforcehcm.com/connect/token
DAYFORCE_CLIENT_NAMESPACE=
DAYFORCE_USERNAME=
DAYFORCE_PASSWORD=
DAYFORCE_CLIENT_ID=Dayforce.HCMAnywhere.Client
