VITE_API_BASE_URL=http://localhost:8000

# Mirrors backend DISABLE_AUTH (see backend/app/config.py). Frontend-side so
# the login screen stays off even if the backend is briefly unreachable -
# the real gate is still the backend's own DISABLE_AUTH flag; this just
# controls what the UI shows while waiting to confirm that. Set to "false"
# (and flip the backend flag too) to bring login back later.
VITE_DISABLE_AUTH=true

